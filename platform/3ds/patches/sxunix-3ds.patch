+static const char *wide_zoom_label(void) {
+#ifdef __3DS__
+  switch (Platform3DS_GetWideZoomIndex()) {
+  case 1: return "1.2X";
+  case 2: return "1.5X";
+  case 3: return "2X";
+  case 4: return "2.5X";
+  case 0:
+  default: return "1X";
+  }
+#else
+  return "1X";
+#endif
