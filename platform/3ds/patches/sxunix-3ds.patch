+static void draw_screen_panel(RectFS r) {
+  draw_text("SCREEN", r.x + r.w / 2 - text_width("SCREEN", 3 * u) / 2,
+            r.y + 18 * u, 3 * u);
+  screen_back_r = (RectFS){r.x + 20 * u, r.y + 12 * u, 90 * u, 38 * u};
+  draw_settings_row(&screen_back_r, false);
