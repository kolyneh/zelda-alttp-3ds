+static void write_ini_gamepad_controls(void) {
+  char v[256];
+  size_t n = 0;
+  for (int i = 0; i < 12; i++) {
+    if (i) n += sprintf(v + n, ", ");
+    if (pad_controls[i] >= 0 && pad_controls[i] < 17)
+      n += sprintf(v + n, "%s", kPadButtonIni[pad_controls[i]]);
+  }
+  update_ini("[GamepadMap]", "Controls", v);
+}
